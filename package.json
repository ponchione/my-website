{
  "name": "my-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "npm run generate",
    "generate": "nuxt generate",
    "postgenerate": "node scripts/finalize-generated.mjs && node scripts/verify-generated.mjs",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:production": "node scripts/audit-production.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:preview": "node scripts/verify-preview.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@lucide/vue": "^1.28.0",
    "@nuxt/content": "^3.15.2",
    "@nuxtjs/color-mode": "^4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^12.5.0",
    "nuxt": "^4.5.1",
    "reka-ui": "^2.10.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.5.2",
    "@types/three": "^0.186.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "fflate": "^0.8.3",
    "happy-dom": "^20.11.1",
    "pngjs": "^7.0.0",
    "polylabel": "^2.1.0",
    "shapefile": "^0.6.6",
    "sharp": "^0.35.5",
    "typescript": "~5.8.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "minimatch": "^10.2.6"
  }
}
