{
  "name": "my-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "npm run generate",
    "generate": "nuxt generate",
    "postgenerate": "node scripts/finalize-generated.mjs && node scripts/verify-generated.mjs",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:production": "node scripts/audit-production.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "preview:worker": "wrangler dev --config wrangler.jsonc --port 4173 --ip 127.0.0.1 --local-protocol https",
    "verify:preview": "node scripts/verify-preview.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "@nuxt/content": "^3.16.2",
    "@nuxtjs/color-mode": "^4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^12.11.1",
    "nuxt": "^4.5.1",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.186.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "happy-dom": "^20.14.6",
    "pngjs": "^7.0.0",
    "polylabel": "^2.1.0",
    "shapefile": "^0.6.6",
    "sharp": "^0.35.5",
    "typescript": "~5.8.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "minimatch": "^10.2.6"
  }
}
