{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-website",
  "main": "worker.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "ponchione.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.ponchione.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.mitchellponchione.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
